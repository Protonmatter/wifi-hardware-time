flowchart TB
  %% --- TRANSMIT PATH ---
  subgraph TX["TRANSMIT PATH"]
    direction TB
    A["Application Event / Send<br/>(Optional Host QPC Stamp)"]
    B["Socket & Network Stack Queues"]
    C["Driver (NBL / skb)<br/>Optional SW Timestamp"]
    D["Host Transport<br/>(PCIe / DMA / USB)"]
    E["NIC / Firmware Queues<br/>(Backoff, Aggregation, Retries)"]
    F["MAC / PHY TX Reference<br/><b>[H_TX Candidate]</b>"]

    A --> B --> C --> D --> E --> F
  end

  %% --- ON AIR ---
  F ==>|"802.11 Frame (No Universal HW Stamp)"| W["OVER THE AIR (RF Propagation)"]
  W ==> G

  %% --- RECEIVE PATH ---
  subgraph RX["RECEIVE PATH"]
    direction TB
    G["MAC / PHY RX Reference<br/><b>[H_RX Candidate]</b>"]
    H["RX Descriptor / Firmware Record"]
    I["Host Transport & Driver<br/>(Decode, Reorder, Deagg)"]
    J["OS Packet Metadata<br/>(NDIS / Socket / Radiotap)"]
    K["Application Receive<br/>(Host Receive Stamp)"]

    G --> H --> I --> J --> K
  end

  %% --- ASYNC & METADATA FLOWS ---
  L["Out-of-Band TX Completion<br/><i>(Completion != RF Launch Time)</i>"]
  M["Qualcomm Hardware Unknowns:<br/>- General RX/TX stamp export<br/>- Exact RF reference points"]

  F -.->|"TX Status / Completion"| L
  L -.->|"Async Timestamp Event"| K

  C -.-> M
  H -.-> M

  %% --- STYLING ---
  classDef gap fill:#fff2dd,stroke:#ac6b12,stroke-width:1.5px,color:#241b0e;
  classDef air fill:#e6eefc,stroke:#315b96,stroke-width:2px,color:#182844;
  classDef hw fill:#fbebeb,stroke:#b83232,stroke-width:1.5px,color:#300;

  class M,L gap;
  class W air;
  class F,G hw;
