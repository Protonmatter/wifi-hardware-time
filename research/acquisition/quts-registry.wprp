<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="WiFi Hardware Time">
  <Profiles>
    <SystemCollector Id="QutsRegistryCollector" Name="QutsRegistryCollector">
      <BufferSize Value="64" />
      <Buffers Value="128" />
    </SystemCollector>
    <SystemProvider Id="QutsRegistryProvider">
      <Keywords><Keyword Value="Registry" /></Keywords>
      <Stacks><Stack Value="RegistryQueryValue" /><Stack Value="RegistryOpenKey" /></Stacks>
    </SystemProvider>
    <Profile Id="QutsRegistry.Verbose.Memory" Name="QutsRegistry" Description="Bounded QUTS registry query observation"
             LoggingMode="Memory" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="QutsRegistryCollector">
          <SystemProviderId Value="QutsRegistryProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
