<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="WiFi Hardware Time">
  <Profiles>
    <SystemCollector Id="WifiPathCollector" Name="WifiPathCollector">
      <BufferSize Value="64" />
      <Buffers Value="512" />
    </SystemCollector>
    <SystemProvider Id="WifiPathProvider">
      <Keywords>
        <Keyword Value="ProcessThread" /><Keyword Value="Loader" />
        <Keyword Value="SampledProfile" /><Keyword Value="DPC" /><Keyword Value="Interrupt" />
      </Keywords>
      <Stacks><Stack Value="SampledProfile" /></Stacks>
    </SystemProvider>
    <Profile Id="WifiPath.Verbose.Memory" Name="WifiPath" Description="Bounded CPU, DPC and interrupt observation beside packet capture" LoggingMode="Memory" DetailLevel="Verbose">
      <Collectors><SystemCollectorId Value="WifiPathCollector"><SystemProviderId Value="WifiPathProvider" /></SystemCollectorId></Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
